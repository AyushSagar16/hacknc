{
  "name": "hacknc",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "live": "tsx --env-file-if-exists=.env scripts/live.ts",
    "sim": "tsx --env-file-if-exists=.env scripts/sim.ts",
    "migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "doctor": "tsx --env-file-if-exists=.env scripts/doctor.ts",
    "demo": "tsx --env-file-if-exists=.env scripts/demo.ts",
    "ops": "tsx --env-file-if-exists=.env scripts/ops.ts",
    "nessie:probe": "tsx --env-file-if-exists=.env scripts/nessie-probe.ts",
    "gemini:smoke": "tsx --env-file-if-exists=.env scripts/gemini-smoke.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:scenarios": "tsx scripts/e2e.ts",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d --wait"
  },
  "dependencies": {
    "@google/genai": "^2.28.0",
    "@spectrum-ts/imessage-local": "^12.10.1",
    "lru-cache": "^11.5.3",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "spectrum-ts": "^12.10.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.9"
  }
}
