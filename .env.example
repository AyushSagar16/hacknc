# Atlas configuration. Copy to .env and fill in what you have; `npm run doctor` checks it.
# Secrets stay server-side and are never logged.

# Which iMessage line: linq (default, free Linq line), local (this Mac's Messages account),
# cloud (Photon Spectrum Cloud; groups need a dedicated Business line), or sim (no phones).
IMESSAGE_MODE=linq
AGENT_NAME=Atlas

# Photon Spectrum Cloud (IMESSAGE_MODE=cloud only).
PROJECT_ID=
PROJECT_SECRET=

# Linq (IMESSAGE_MODE=linq): `npm i -g @linqapp/cli && linq signup`, then paste the API key.
LINQ_API_KEY=
LINQ_WEBHOOK_PORT=8788
# relay = `npm run live` forwards via `linq webhooks listen` (no public URL needed).
# subscription = a permanent webhook to a public tunnel; then LINQ_WEBHOOK_SECRET is required.
LINQ_WEBHOOK_MODE=relay
LINQ_WEBHOOK_SECRET=

# Postgres with TimescaleDB + pgvector + pgvectorscale. Tiger Cloud:
#   postgres://tsdbadmin:<password>@<service>.<project>.tsdb.cloud.timescale.com:<port>/tsdb?sslmode=require
# Local: `npm run db:up` and leave this empty (postgres://atlas:atlas@localhost:54329/atlas).
DATABASE_URL=
DATABASE_POOL_MAX=5

# Gemini (https://aistudio.google.com/apikey). Models can be overridden.
# One key, or several comma-separated (key1,key2,...): calls are spread across them, and a key
# that runs out of quota is skipped while the others carry on. Quota is per Google Cloud project,
# so keys only add capacity when each comes from a different project.
GEMINI_API_KEY=
GEMINI_MODEL_AGENT=gemini-3.5-flash-lite
GEMINI_MODEL_GATE=gemini-3.5-flash-lite
GEMINI_MODEL_EXTRACT=gemini-3.1-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-2
# Tried in order when a model is overloaded (503) or times out.
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-3-flash-preview,gemini-3.8-flash
# live | fake (no model calls; deterministic features still work)
LLM_MODE=live

# Capital One Nessie sandbox (sign in with GitHub at nessieisreal.com → profile → API key).
NESSIE_API_KEY=
NESSIE_BASE_URL=https://api.nessieisreal.com

# SerpApi for live Google Flights / Hotels prices (free plan: 250 searches/month).
# Without it, flights are labeled catalog estimates; stays use the keyless sources below.
SERPAPI_API_KEY=

# Keyless stay prices when SerpApi has no answer: hotel rates from Xotelo (TripAdvisor partner
# rates) and rentals from Airbnb's search page. on/off; default on for a real line, off in the sim.
FREE_STAY_PRICES=

# Trip pages (web/): Atlas publishes each trip to Supabase and links it in the chat. Run
# supabase/migrations on the project first. Leave empty to turn trip pages off.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Where web/ is deployed, e.g. https://planwithatlas.tech
SITE_BASE_URL=

# Bank connect: "connect your capital one" links go to SITE_BASE_URL/connect/<signed token>.
# CONNECT_SECRET signs the token and the web page's callback; set the SAME value in web/.env
# (`openssl rand -base64 32`). Empty: the simulator uses a fixed dev secret, a real line a random
# per-process one (links then can't be verified by the site).
CONNECT_SECRET=
# Atlas's public URL for the consent page's POST /connect-callback (served on LINQ_WEBHOOK_PORT).
# `npm run live` sets it to the cloudflared tunnel automatically; set it only for a fixed host.
PUBLIC_BASE_URL=

# Follow up this many seconds after a group goes quiet on an unanswered message (0 = off; empty =
# 150 on a real line, off in the simulator).
NUDGE_IDLE_SECONDS=
# Message cadence: typing indicator + a pause per bubble of PACE_BASE_MS + PACE_MS_PER_CHAR·chars,
# clamped to [PACE_MIN_MS, PACE_MAX_MS]; the first bubble waits at most PACE_FIRST_MAX_MS. PACING=off sends back to back.
PACING=on
PACE_BASE_MS=400
PACE_MS_PER_CHAR=25
PACE_MIN_MS=600
PACE_MAX_MS=2500
PACE_FIRST_MAX_MS=1000
# Quiet window before answering a complete message that names Atlas (everything else waits 2.5 s).
ADDRESSED_DEBOUNCE_MS=1500

# Comma-separated provider chat ids Atlas may answer in (empty = any chat it's added to).
ALLOWED_CHATS=
# Handles allowed to use operator commands from a DM (e.g. +19195550100).
OPERATOR_HANDLES=
CONSOLE_PORT=8790
DEFAULT_TIMEZONE=America/New_York
LOG_LEVEL=info
LOG_FILE=
