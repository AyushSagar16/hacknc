expect atlas !~ /budget is now \$1,000,000/
expect sql SELECT count(*)::int AS n FROM budgets WHERE adjusted_cents IS NOT NULL AND (adjusted_cents < 5000 OR adjusted_cents > 2000000) = [{"n":0}]
