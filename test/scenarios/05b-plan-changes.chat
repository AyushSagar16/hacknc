# The trip fund follows the group: a share over someone's (private) budget is flagged without the
# number, someone who joins after the stay is booked gets one line (not the whole plan again),
# someone who leaves stops paying in, and switching destination takes the old stay off the fund.
today 2026-10-10 14:00
members maya leo priya
atlas joins
~agent text: NO_REPLY
maya: hi
~agent text: NO_REPLY
leo: hi
~agent text: NO_REPLY
priya: hi
jobs
~extract [{"message":0,"about":"maya","key":"date_window","polarity":"positive","explicit":true,"retracts":false,"confidence":0.9,"quote":"nov 12-16","earliest":"2026-11-12","latest":"2026-11-16"},{"message":0,"about":"maya","key":"home_city","polarity":"positive","explicit":true,"retracts":false,"confidence":0.9,"quote":"raleigh","city":"Raleigh"}]
maya: nov 12-16 from raleigh works for all of us
maya: set my budget to 900
leo: set my budget to 900
priya: set my budget to 200
maya: set my budget to 1000000
expect atlas ~ "must be nice"
expect sql SELECT count(*)::int AS n FROM budgets WHERE adjusted_cents > 2000000 = [{"n":0}]
~agent call lock_destination {"destination":"charleston"}
~agent text: NO_REPLY
maya: atlas everyone agreed, we're doing charleston
expect atlas ~ "charleston it is!"
stays test/fixtures/serpapi/google_hotels_charleston.json | test/fixtures/serpapi/google_vacation_rentals_charleston.json
~agent call find_stays {}
~agent text: NO_REPLY
leo: atlas where should we stay?
expect atlas ~ "nothing fits everyone's budget, so these are the cheapest i found"
expect transcript !~ /\$200|\$100\b/
~agent call book_stay {"option":"1"}
~agent text: NO_REPLY
maya: atlas book the bungalow
expect atlas ~ "🏠 booked ✓ Cozy Wagener Terrace Bungalow"
expect atlas ~ "🏦 charleston trip fund: $660 ($660 for the stay)"
expect atlas ~ "everyone puts in $220"
expect atlas ~ "heads up priya, with travel this is above what you said works for you"
leo: what's our budget
expect atlas ~ "the locked plan is over budget for priya"
expect atlas !~ "which works for everyone"
# a late joiner gets their own share and one line; everyone else's share drops
sam joins
jobs
expect atlas ~ "added sam to the trip fund: $165"
expect atlas ~ "everyone else's share is now $165"
expect sql SELECT count(*)::int AS n FROM fund_txns f JOIN people p ON p.id = f.person_id WHERE p.display_name = 'Sam' AND f.status = 'scheduled' = [{"n":1}]
# someone who leaves stops paying in
leo leaves
jobs
expect atlas ~ "took leo off the trip fund"
expect sql SELECT count(*)::int AS n FROM fund_txns f JOIN people p ON p.id = f.person_id WHERE p.display_name = 'Leo' AND f.status = 'scheduled' = [{"n":0}]
# switching destination: the old stay comes off the fund and nobody's scheduled to pay for it
~agent call lock_destination {"destination":"savannah"}
~agent text: NO_REPLY
maya: atlas actually let's do savannah instead
expect atlas ~ "savannah it is!"
jobs
expect sql SELECT stay IS NULL AS cleared, stages->>'stay' AS stage FROM trips = [{"cleared":true,"stage":"open"}]
expect sql SELECT status FROM fund_items = [{"status":"removed"}]
expect sql SELECT count(*)::int AS n FROM fund_txns WHERE status = 'scheduled' = [{"n":0}]
