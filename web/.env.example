# Same Supabase project the Atlas bot publishes to. The service-role key stays server-side
# (pages and OG images read with it); never expose it with a NEXT_PUBLIC_ prefix.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Public origin of this site, used for absolute OG image URLs (e.g. https://atlas-trips.vercel.app).
NEXT_PUBLIC_SITE_URL=
# Bank connect (/connect/<token>): the same CONNECT_SECRET as Atlas's .env. It verifies the link
# and signs the callback to Atlas (x-atlas-signature). Server-side only.
CONNECT_SECRET=
